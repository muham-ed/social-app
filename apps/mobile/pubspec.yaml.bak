publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.3.0 <4.0.0'
  flutter: '>=3.22.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter

  # State Management
  flutter_bloc: ^8.1.6
  equatable: ^2.0.5
  dartz: ^0.10.1

  # Routing
  go_router: ^14.2.0

  # DI
  get_it: ^7.7.0

  # Network
  dio: ^5.5.0
  web_socket_channel: ^3.0.1
  socket_io_client: ^3.1.2

  # Storage
  shared_preferences: ^2.2.3
  flutter_secure_storage: ^9.2.2

  # Location
  geolocator: ^13.0.1
  geocoding: ^3.0.0

  # Media
  image_picker: ^1.1.2
  video_player: ^2.9.1
  chewie: ^1.8.5
  cached_network_image: ^3.4.1
  just_audio: ^0.9.40
  permission_handler: ^11.3.1
  record: ^5.1.0

  # Agora
  agora_rtc_engine: ^6.3.2

  # Notifications
  firebase_core: ^3.2.0
  firebase_messaging: ^15.0.3
  flutter_local_notifications: ^17.2.2

  # UI
  flutter_svg: ^2.0.10+1
  google_fonts: ^6.2.1
  shimmer: ^3.0.0
  lottie: ^3.1.2
  intl: ^0.20.2

  # Utils
  freezed_annotation: ^2.4.4
  json_annotation: ^4.9.0
  uuid: ^4.4.0
  logger: ^2.4.0
  connectivity_plus: ^6.0.3
  path_provider: ^2.1.3
  url_launcher: ^6.3.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0
  build_runner: ^2.4.11
  freezed: ^2.4.7
  json_serializable: ^6.8.0
  bloc_test: ^9.1.7
  mocktail: ^1.0.4

flutter:
  uses-material-design: true
  generate: true

  assets:
    - assets/images/
    - assets/icons/
    - assets/animations/